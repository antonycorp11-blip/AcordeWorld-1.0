    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "{PLAYER_NAME}. Certo. Já está no registro."
    },
    {
      "cmd": "falar",
      "quem": "Personagem",
      "texto": "Como você...?",
      "auto": 1300
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Mirela mandou um mensageiro antes do sol nascer. Aquela mulher acorda cedo demais."
    },
    {
      "cmd": "esperar",
      "ms": 400
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Item declarado: uma clave musical."
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Nossa. Você a tirou de um Shiker? Sozinho?"
    },
    {
      "cmd": "falar",
      "quem": "Personagem",
      "texto": "Ele começou.",
      "auto": 1400
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Eu vou anotar exatamente isso."
    },
    {
      "_": "── Boas-vindas e destino ──"
    },
    {
      "cmd": "esperar",
      "ms": 500
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Ah, e o portão. Você deve estar se perguntando como ele abriu."
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Fechadura de Acordelot não tem chave. Tem acorde."
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Três notas certas na ordem certa, e a pedra entende. Errou uma? Fica do lado de fora escutando."
    },
    {
      "cmd": "falar",
      "quem": "Personagem",
      "texto": "E se alguém não souber música?"
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Aí não entra. — Não é grosseria. É que aqui a cidade inteira é feita disso."
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Bem-vindo a Acordelot, {PLAYER_NAME}. Primeira cidade do Reino da Música."
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Todo músico do reino começa a jornada aqui. Alguns terminam também, mas isso é outra conversa."
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Somos quatro clãs. Teclas constroem, Cordas caçam, Vocais curam, Ritmos seguram."
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Nenhum toca a música inteira sozinho. É por isso que a gente se aguenta."
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Procure o Sr. Antony, na Praça Central. Ele é o líder daqui."
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Homem sábio. Fala bonito. Fala muito. Leve paciência."
    },
    {
      "cmd": "falar",
      "quem": "Personagem",
      "texto": "Anotado.",
      "auto": 1200
    },
    {
      "cmd": "falar",
      "quem": "Guarda Renaldo",
      "texto": "Siga a estrada de pedra. Não tem como errar — é a única."
    },
    {
      "cmd": "tutorial",
      "texto": "Siga a estrada de pedra até a Praça Central e fale com o Sr. Antony."
